[
  {
    "pattern": "failed to create (thumbnail \\[-50\\]|image \\[-62\\])|could not find plugin for image source \\[11 bytes\\] 6E 6F 74 20 61 20 70 68",
    "reason": "ImageIO logs an error when data is not an image. CroppedPhotoTests gives it \"not a photo\" on purpose, and CroppedPhoto must answer nil for it."
  },
  {
    "pattern": "building pipeline primitive_color-\\S+ took [0-9.]+ seconds",
    "reason": "The graphics system logs at error level how long it took to build a Metal shader for a drawing. Not a Grosh error, and the time differs on every run."
  }
]
